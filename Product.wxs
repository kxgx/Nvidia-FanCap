<?xml version="1.0" encoding="utf-8"?>
<!--
  Nvidia-FanCap MSI package (WiX Toolset v4+).
  Builds with: wix build -arch x64 Product.wxs -o dist\Nvidia-FanCap-<version>-x64.msi
  - installs the single native exe + settings file to Program Files
  - creates a Start Menu shortcut (opens the settings UI, no admin needed)
  - registers/removes the hidden elevated logon task through the exe itself,
    so every path is derived from the install location (fully generic)
-->
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs">
  <Package Name="Nvidia-FanCap"
           Manufacturer="Nvidia-FanCap"
           Version="1.0.29"
           UpgradeCode="6F2A9C7E-1D4B-4A83-9E5C-2B7F0A3D8C11"
           Scope="perMachine"
           Language="2052"
           InstallerVersion="500">

    <SummaryInformation Description="NVIDIA 显卡风扇上限强制控制（64 位）" />
    <MajorUpgrade DowngradeErrorMessage="已安装更新版本的 Nvidia-FanCap，请先卸载旧版本。" />
    <MediaTemplate EmbedCab="yes" CompressionLevel="high" />

    <StandardDirectory Id="ProgramFiles64Folder">
      <Directory Id="INSTALLFOLDER" Name="Nvidia-FanCap">
        <Component Id="ExeComponent">
          <File Id="ExeFile" Source="dist\Nvidia-FanCap-x64.exe" KeyPath="yes" DefaultVersion="1.0.29.0" />
        </Component>
        <Component Id="IniComponent">
          <File Id="IniFile" Source="dist\Nvidia-FanCap.ini" DefaultVersion="1.0.29.0" />
        </Component>
        <Component Id="TaskXmlComponent">
          <File Id="TaskXml" Source="task.xml" DefaultVersion="1.0.29.0" />
        </Component>
      </Directory>
    </StandardDirectory>

    <StandardDirectory Id="ProgramMenuFolder">
      <Directory Id="AppStartMenuFolder" Name="Nvidia-FanCap">
        <Component Id="StartMenuShortcut">
          <Shortcut Id="SettingsShortcut"
                    Name="Nvidia-FanCap 设置"
                    Description="显卡风扇上限设置"
                    Target="[INSTALLFOLDER]Nvidia-FanCap-x64.exe"
                    WorkingDirectory="INSTALLFOLDER" />
          <RemoveFolder Id="RemoveStartMenuFolder" On="uninstall" />
          <RegistryValue Root="HKLM" Key="Software\Nvidia-FanCap" Name="StartMenu"
                         Type="integer" Value="1" KeyPath="yes" />
        </Component>
      </Directory>
    </StandardDirectory>

    <Feature Id="ProductFeature" Level="1">
      <ComponentRef Id="ExeComponent" />
      <ComponentRef Id="IniComponent" />
      <ComponentRef Id="TaskXmlComponent" />
      <ComponentRef Id="StartMenuShortcut" />
    </Feature>

    <!-- Register/remove the logon task with the system's schtasks.exe.
         A plain "schtasks /create /f" fails while the previous task is still
         running (upgrade: the old daemon is alive), so the sequence is
         end -> wait -> create -> run. Uninstall stops the daemon and waits for
         the process to die before the files are removed. -->
    <CustomAction Id="CreateTask" Directory="SystemFolder"
                  ExeCommand="cmd.exe /c &quot;schtasks /end /tn NvidiaFanCap &gt;&gt; C:\ProgramData\fancap-ca.log 2&gt;&amp;1 &amp; ping -n 3 127.0.0.1 &gt;nul &amp; schtasks /create /tn NvidiaFanCap /xml &quot;[INSTALLFOLDER]task.xml&quot; /f &gt;&gt; C:\ProgramData\fancap-ca.log 2&gt;&amp;1 &amp; schtasks /run /tn NvidiaFanCap &gt;&gt; C:\ProgramData\fancap-ca.log 2&gt;&amp;1&quot;"
                  Execute="deferred" Impersonate="yes" Return="ignore" />
    <CustomAction Id="UninstallDaemon" Directory="SystemFolder"
                  ExeCommand="cmd.exe /c &quot;schtasks /end /tn NvidiaFanCap &amp; ping -n 4 127.0.0.1 &gt;nul &amp; taskkill /f /im Nvidia-FanCap-x64.exe &amp; schtasks /delete /tn NvidiaFanCap /f&quot;"
                  Execute="immediate" Impersonate="yes" Return="ignore" />

    <InstallExecuteSequence>
      <Custom Action="UninstallDaemon" Before="RemoveFiles" Condition="REMOVE=&quot;ALL&quot;" />
      <!-- "NOT Installed" is true for a first install AND for an upgrade, false for
           an uninstall. ("NOT REMOVE" is false during upgrades because
           RemoveExistingProducts sets REMOVE=ALL for the whole sequence, which
           silently skipped the registration on every upgrade.) -->
      <Custom Action="CreateTask" After="InstallFiles" Condition="NOT Installed" />
    </InstallExecuteSequence>

  </Package>
</Wix>

























